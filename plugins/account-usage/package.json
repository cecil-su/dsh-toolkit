{
  "name": "@local/account-usage",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "See Codex account quota and reset times from the chat composer.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "usage.js", "cordis.patch.yml", "locale/*.json", "README.md", "icon.svg"],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-api-remotes"]
    }
  }
}
